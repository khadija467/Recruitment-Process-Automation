        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are screening a candidate for an AI Automations Engineer role requiring n8n, Zapier/Make, Python, APIs, and 1-3 years experience. Candidate skills: {{ $json.skills_text }}. Experience: {{ $json.experience_years }} years. Return ONLY valid JSON with no markdown formatting and no explanation, in exactly this shape: {\\\"score\\\": 0-100, \\\"tag\\\": \\\"Shortlist\\\", \\\"reason\\\": \\\"one short sentence\\\"} where tag must be exactly one of Shortlist, Review, or Reject.\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.2\n  }\n}",
        "options": {}
      },
