    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nconst original = $('Structure Data').first().json;\nreturn [{\n  json: {\n    ...original,\n    score: parsed.score,\n    tag: parsed.tag,\n    reason: parsed.reason\n  }\n}];"
      },
